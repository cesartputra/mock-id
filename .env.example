# Demo local. Copy to .env; launcher reads plain values, never executes shell.
MOCK_ID_MODE=demo
MOCK_ID_PAD_PROVIDER=auto
PORT=4173
# Optional remote Tier 2 worker. Fill secrets outside Git, use HTTPS in deployment.
MOCK_ID_PAD_WORKER_URL=
MOCK_ID_WORKER_TOKEN=
WORKER_PORT=4181
# Production needs 32 random bytes encoded as base64, from a secret manager.
MOCK_ID_ENCRYPTION_KEY=
# Optional shared PostgreSQL. Empty means local SQLite.
MOCK_ID_DATABASE_URL=
MOCK_ID_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
MOCK_ID_CALIBRATION_FILE=
MOCK_ID_CALIBRATION_SHA256=
MOCK_ID_EVIDENCE_BUCKET=
MOCK_ID_S3_ENDPOINT=
# Optional sticky routing registry; does not serialize camera state.
MOCK_ID_REDIS_URL=
MOCK_ID_GATEWAY_ID=
